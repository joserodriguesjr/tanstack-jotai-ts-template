{
  "short_name": "Pokedex",
  "name": "Pokedex App",
  "description": "A PWA for browsing Pokémon data",
  "start_url": "/?source=pwa",
  "id": "/",
  "display": "standalone",
  "theme_color": "#000000",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "64x64",
      "type": "image/x-icon"
    },
    {
      "src": "icons/logo192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "icons/logo512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ],
  "screenshots": [
        {
            "src": "img/mobile-screenshot1.png",
            "type": "image/png",
            "sizes": "409x542",
            "form_factor": "wide"
        },
        {
          "src": "img/mobile-screenshot1.png",
          "type": "image/png",
          "sizes": "409x542"
      }
  ]
}
